{
  "name": "agent-host",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.41.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node core/server.mjs",
    "postinstall": "node scripts/node-pty-mode.cjs",
    "test": "node tests/run.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:delivery": "node tests/delivery-cli.mjs",
    "lint:i18n": "node tests/lint-i18n.mjs",
    "test:safe-storage": "electron tests/desktop/safe-storage-smoke.cjs",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder",
    "desktop:store": "electron-builder --config electron-builder.store.cjs --win --publish never",
    "release:prepare": "node scripts/release-info.mjs",
    "release:bump": "node scripts/release-bump.mjs",
    "predesktop:dist": "npm run release:prepare",
    "predesktop:pack": "npm run release:prepare",
    "predesktop:store": "npm run release:prepare"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "agent-browser": "0.39.1",
    "electron-updater": "6.8.9",
    "i18next": "26.4.2",
    "koffi": "3.3.2",
    "pdfjs-dist": "5.5.207",
    "smol-toml": "1.9.1",
    "ws": "^8.21.3",
    "yaml": "2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "bin": {
    "pleiad": "bin/pleiad.mjs"
  },
  "main": "desktop/main.cjs",
  "description": "Pleiad desktop workspace for coding agents",
  "author": "Pleiad",
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
