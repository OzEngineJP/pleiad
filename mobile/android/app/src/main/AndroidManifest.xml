<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".PleiadApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- The launcher entry: a trampoline that never stays (docs/remote.md §8.2). A tap on the icon brings the
             existing task forward as it is — the host window is not recreated — and only a fresh task goes on to the
             shell. The shell keeps singleTask so the link intents below keep their onNewIntent delivery. -->
        <activity
            android:name=".LauncherActivity"
            android:theme="@style/AppTheme.Trampoline"
            android:label="@string/app_name"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The shell (Capacitor): host list, pairing -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- pleiad://pair?... (the host's pairing QR opened by the system camera). Pairing still asks first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pleiad" android:host="pair" />
            </intent-filter>

            <!-- pleiad://open?h=<hostId>&s=<sessionId>: a notification (ADR 0086) opening that conversation. It only opens the
                 host's window on a host already paired here; nothing is read or changed by the link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pleiad" android:host="open" />
            </intent-filter>

            <!-- Pleiad Plus sign-in: the page returns through this verified App Link (docs/plus.md "Android"). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="account.pleiad.dev" android:path="/app/callback" />
            </intent-filter>

            <!-- Fallback for builds whose App Link is not verified (e.g. locally signed): the page offers
                 pleiad://auth?code=…&state=… as the way back. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pleiad" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- One host's UI: a plain WebView on the in-app loopback proxy (no Capacitor bridge) -->
        <activity
            android:name=".HostActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Notifications while away (ADR 0086): keeps one light line per host to the relay and shows what arrives.
             remoteMessaging: messages from another device (not dataSync, which Android stops after 6 hours) -->
        <service
            android:name=".NotifyService"
            android:foregroundServiceType="remoteMessaging"
            android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ML Kit barcode UI module (QR scanning of the pairing code) -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 通話モード（docs/voice-call.md）のマイク。いまは中継越しの画面には通話を出さない（ホストが対応を伝えない）ので、実機の確認はしていない -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
